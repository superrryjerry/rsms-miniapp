.status-row { margin-bottom: 16rpx; }
.section-title { display: block; font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.photo { width: 200rpx; height: 200rpx; border-radius: 8rpx; }
.action-bar { display: flex; gap: 20rpx; padding: 20rpx 0; }
.action-bar button { flex: 1; font-size: 28rpx; border-radius: 8rpx; }
.btn-edit { background: #1890ff; color: #fff; }
.btn-delete { background: #fff1f0; color: #ff4d4f; border: 1rpx solid #ffa39e; }
